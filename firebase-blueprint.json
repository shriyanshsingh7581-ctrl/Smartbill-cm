{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Shop profile, branding, invoice settings, billing settings, and online store preferences for a merchant.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated shop owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopName": {
          "type": "string",
          "description": "Registered or display name of the retail shop",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerName": {
          "type": "string",
          "description": "Name of the shop owner",
          "minLength": 0,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Primary contact phone number",
          "minLength": 0,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "description": "Merchant email address",
          "minLength": 0,
          "maxLength": 150
        },
        "address": {
          "type": "string",
          "description": "Shop physical address",
          "minLength": 0,
          "maxLength": 300
        },
        "gstNumber": {
          "type": "string",
          "description": "Shop GSTIN number",
          "minLength": 0,
          "maxLength": 30
        },
        "fssaiNumber": {
          "type": "string",
          "description": "Shop FSSAI license number",
          "minLength": 0,
          "maxLength": 30
        },
        "logoUrl": {
          "type": "string",
          "description": "Cloudinary URL of the shop logo",
          "minLength": 0,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "description": "Selected UI language code",
          "enum": ["en", "hi", "gu", "mr"],
          "minLength": 2,
          "maxLength": 10
        },
        "configPayload": {
          "type": "string",
          "description": "Serialized invoice, billing, printer, and online store configuration map",
          "minLength": 0,
          "maxLength": 15000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["ownerId", "shopName", "language", "configPayload", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory stock item with pricing, barcode, GST, rack, expiry, and variants.",
      "type": "object",
      "properties": {
        "ownerId": {
