  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Root merchant profile document scoped to userId"
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Per-user products and stock inventory"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Per-user POS bills and customer orders"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Per-user supplier purchase entries"
    },
    "/users/{userId}/returns/{returnId}": {
      "schema": { "$ref": "#/entities/SaleReturn" },
      "description": "Per-user sale return and exchange entries"
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Per-user suppliers and supplier ledger"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Per-user customers and customer ledger"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Per-user business expenses"
    },
    "/users/{userId}/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Per-user staff members and attendance"
    }
  }
}
