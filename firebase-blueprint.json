        "totalProfit": {
          "type": "number"
        },
        "itemCount": {
          "type": "number"
        },
        "itemsPayload": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "invoiceNumber", "dateStr", "timeStr", "paymentMode", "priceMode", "totalMrp", "totalAmount", "paidAmount", "discountAmount", "totalProfit", "itemCount", "itemsPayload", "createdAt", "updatedAt"]
    },
