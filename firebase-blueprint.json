        "barcode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "mrp": {
          "type": "number"
        },
        "retailPrice": {
          "type": "number"
        },
        "wholesalePrice": {
          "type": "number"
        },
        "purchasePrice": {
          "type": "number"
        },
        "quantity": {
          "type": "number"
        },
        "lowStockAlert": {
          "type": "number"
        },
        "gst": {
          "type": "number"
        },
        "cess": {
          "type": "number"
        },
        "hsn": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "rack": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "supplierName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "expiryDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "imageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "archived": {
          "type": "boolean"
        },
        "detailsPayload": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "unit", "mrp", "retailPrice", "quantity", "archived", "createdAt", "updatedAt"]
    },
    "Order": {
